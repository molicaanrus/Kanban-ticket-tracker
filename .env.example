# Copy this file to ".env" to override defaults. ".env" is ignored by git: never commit real secrets.

# --- Email (verification messages) ---
# Default (no .env needed): messages go to the bundled Mailpit inbox at http://localhost:8025
# To send through the DataArt relay, uncomment:
# SMTP_HOST=relay1.dataart.com
# SMTP_PORT=25
# SMTP_SECURE=false
# SMTP_FROM=Ticket Tracker <your.address@dataart.com>
# If the relay requires a login:
# SMTP_USER=
# SMTP_PASS=

# Public address of the app, used in verification links
# APP_BASE_URL=http://localhost:8080

# Database password for the local PostgreSQL container
# Leave unset: a random password is generated at first start. Set it only if you want to choose your own.
# POSTGRES_PASSWORD=

# Set to true when the app is served over HTTPS
# COOKIE_SECURE=false

# Only for an SMTP relay with a self-signed certificate (default: certificates are verified)
# SMTP_TLS_REJECT_UNAUTHORIZED=false

# Set by docker-compose.yml, change only when running the server outside Compose:
# PORT=3000
# DATABASE_URL=postgres://tracker@db:5432/tracker
# DB_PASSWORD_FILE=/secrets/db_password
# STATIC_DIR=../client/dist
# MAIL_TRANSPORT=memory   (tests only: keeps e-mails in memory)
